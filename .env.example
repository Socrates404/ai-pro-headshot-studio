# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Replicate API token — get yours at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your trained LoRA model on Replicate (username/model-name:version-hash)
# Example: johnsmith/johnsmith-lora:abc123def456...
MODEL_NAME=username/your-lora-model:version_hash
